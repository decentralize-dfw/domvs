Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Remove .html extension — serve clean URLs (root and sub-folders, e.g. /tr/services)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 301 redirects: legacy blog-N URLs → clean slugs
  RewriteRule ^blog-1$   /blog/the-bosphorus-premium                   [R=301,L]
  RewriteRule ^blog-2$   /blog/brera-navigli-isola                     [R=301,L]
  RewriteRule ^blog-3$   /blog/luxembourg-quiet-supremacy              [R=301,L]
  RewriteRule ^blog-4$   /blog/psychology-luxury-property-presentation [R=301,L]
  RewriteRule ^blog-5$   /blog/meridian-triangle                       [R=301,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Caching — hashed-free assets are long-lived, HTML is revalidated
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType model/gltf-binary       "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|svg|glb|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# glTF is not in the default mime table
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
</IfModule>
